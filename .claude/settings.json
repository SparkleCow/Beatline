{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/**)",
      "Edit(/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git lfs ls-files *)",
      "Bash(git lfs status *)",
      "Bash(./tools/godot.sh *)",
      "Bash(./tools/verify.sh *)",
      "Bash(bash tools/godot.sh *)",
      "Bash(bash tools/verify.sh *)",
      "Bash(godot --headless *)",
      "Bash(godot4 --headless *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(del *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git rm *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pip install *)",
      "Bash(winget *)",
      "Bash(choco *)",
      "Bash(scoop *)",
      "Bash(apt *)",
      "Bash(brew *)",
      "PowerShell(winget *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./secrets/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ]
  }
}
